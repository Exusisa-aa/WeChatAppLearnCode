.search-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-top: 20rpx;
}

.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f0f0f0;
  border-radius: 40rpx;
  padding: 15rpx 20rpx;
  margin-right: 20rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-icon {
  font-size: 32rpx;
  color: #999;
  margin-left: 10rpx;
}

.cancel-btn {
  font-size: 28rpx;
  color: #007aff;
  padding: 10rpx 20rpx;
}

.city-item {
  background-color: #fff;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  align-items: center;
}

.city-name {
  font-size: 30rpx;
  color: #333;
  flex: 1;
}

.hot-cities-section {
  background-color: #fff;
  margin-top: 20rpx;
  padding: 0 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0 20rpx;
  border-bottom: 1rpx solid #eee;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  font-weight: bold;
}

.clear-history {
  font-size: 24rpx;
  color: #999;
}

.hot-cities-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding: 20rpx 0 40rpx;
}

.hot-city-item {
  background-color: #f8f8f8;
  padding: 25rpx 0;
  text-align: center;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #333;
}

.empty-result {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 搜索结果高亮样式 */
.highlight {
  color: #007aff;
  font-weight: bold;
}